<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "1 POINT SLAM" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="1 POINT SLAM">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png?v=3" type="image/png">
    <link rel="icon" href="/icon.svg?v=3" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=3">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 min-h-screen <%= "about-page" if controller_name == "home" && action_name == "about" %>">
    <header class="fixed top-0 inset-x-0 z-50 bg-white border-b border-slate-200 shadow-sm">
      <nav class="container mx-auto px-5 py-3 flex items-center justify-between overflow-x-auto text-sm">
        <%= link_to "1 POINT SLAM", about_path, class: "text-lg font-bold text-emerald-700 hover:text-emerald-600 whitespace-nowrap" %>

        <div class="flex items-center gap-6 whitespace-nowrap">
          <% if authenticated? %>
            <%= link_to "🏆 Tournament", tournaments_path, class: nav_link_class(controller_name == "tournaments") %>
            <%= link_to "⚔️ Next Match", my_match_path, class: nav_link_class(controller_name == "home" && action_name == "my_match") %>
            <%= link_to "👥 メンバーリスト", users_path, class: nav_link_class(controller_name == "users" && action_name == "index") %>
            <% if current_user.admin? %>
              <%= link_to "トーナメント作成", new_tournament_path, class: "px-3 py-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium whitespace-nowrap" %>
            <% end %>
            <%= link_to user_path(current_user), class: "#{nav_link_class(controller_name == 'users' && action_name == 'show' && params[:id] == current_user.id.to_s)} hidden sm:inline-flex items-center gap-2" do %>
              <%= user_avatar_tag(current_user, css_class: "avatar avatar--sm") %>
              <%= current_user.name %>
              <% if current_user.admin? %>
                <span class="ml-1 px-2 py-0.5 bg-amber-100 text-amber-800 rounded-full text-xs">管理者</span>
              <% end %>
            <% end %>
            <%= button_to "ログアウト", session_path, method: :delete, class: "text-slate-500 hover:text-slate-700 bg-transparent" %>
          <% else %>
            <%= link_to "1 POINT SLAMとは", about_path, class: nav_link_class(controller_name == "home" && action_name == "about") %>
            <%= link_to "新規登録", new_registration_path, class: nav_link_class(controller_name == "registrations") %>
            <%= link_to "ログイン", new_session_path, class: "px-3 py-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium whitespace-nowrap" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="mx-auto px-5 py-8 max-w-6xl mt-20">
      <% if alert = flash[:alert] %>
        <p class="mb-4 py-2 px-4 bg-red-50 text-red-600 rounded-lg border border-red-100"><%= alert %></p>
      <% end %>
      <% if notice = flash[:notice] %>
        <p class="mb-4 py-2 px-4 bg-emerald-50 text-emerald-700 rounded-lg border border-emerald-100"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
