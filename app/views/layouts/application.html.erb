<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "1 POINT SLAM" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="1 POINT SLAM">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 min-h-screen">
    <header class="fixed top-0 inset-x-0 z-50 bg-white border-b border-slate-200 shadow-sm">
      <nav class="container mx-auto px-5 py-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <%= link_to "1 POINT SLAM", root_path, class: "text-lg font-bold text-emerald-700 hover:text-emerald-600 mr-2" %>

        <%= link_to "1 POINT SLAMの説明", about_path, class: "text-slate-600 hover:text-slate-900" %>

        <% if authenticated? %>
          <%= link_to "トーナメント全体", tournaments_path, class: "text-slate-600 hover:text-slate-900" %>
          <%= link_to "自分の次の試合", my_match_path, class: "text-slate-600 hover:text-slate-900" %>
          <%= link_to "ユーザーの詳細", user_path(current_user), class: "text-slate-600 hover:text-slate-900" %>
          <%= link_to "ユーザー一覧", users_path, class: "text-slate-600 hover:text-slate-900" %>
          <% if current_user.admin? %>
            <%= link_to "トーナメント作成", new_tournament_path, class: "px-3 py-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium" %>
          <% end %>
        <% else %>
          <%= link_to "ユーザー登録", new_registration_path, class: "text-slate-600 hover:text-slate-900" %>
        <% end %>

        <div class="ml-auto flex items-center gap-3">
          <% if authenticated? %>
            <span class="text-slate-600 hidden sm:inline">
              <%= current_user.name %>
              <% if current_user.admin? %>
                <span class="ml-1 px-2 py-0.5 bg-amber-100 text-amber-800 rounded-full text-xs">管理者</span>
              <% end %>
            </span>
            <%= button_to "ログアウト", session_path, method: :delete, class: "text-slate-500 hover:text-slate-700 underline bg-transparent" %>
          <% else %>
            <%= link_to "ログイン", new_session_path, class: "px-3 py-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto px-5 py-8 max-w-6xl mt-20">
      <% if alert = flash[:alert] %>
        <p class="mb-4 py-2 px-4 bg-red-50 text-red-600 rounded-lg border border-red-100"><%= alert %></p>
      <% end %>
      <% if notice = flash[:notice] %>
        <p class="mb-4 py-2 px-4 bg-emerald-50 text-emerald-700 rounded-lg border border-emerald-100"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
