<div>
  <h1 class="text-3xl font-bold text-slate-800 mb-2">1 POINT SLAM</h1>
  <p class="text-slate-600 mb-8">勝ち残りトーナメントを作成し、リアルタイムで進行を共有できます。</p>

  <% if authenticated? %>
    <div class="grid md:grid-cols-2 gap-6">
      <section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">すべてのトーナメント</h2>
        <% if @tournaments.any? %>
          <ul class="space-y-3">
            <% @tournaments.each do |tournament| %>
              <li>
                <%= link_to tournament_path(tournament), class: "block p-3 rounded-lg border border-slate-100 hover:border-emerald-200 hover:bg-emerald-50 transition" do %>
                  <span class="font-medium text-slate-800"><%= tournament.name %></span>
                  <span class="ml-2 text-xs px-2 py-0.5 rounded-full <%= tournament_status_class(tournament) %>">
                    <%= tournament_status_label(tournament) %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-slate-500">まだトーナメントがありません。</p>
        <% end %>
      </section>

      <section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">参加中のトーナメント</h2>
        <% if @my_tournaments.any? %>
          <ul class="space-y-3">
            <% @my_tournaments.each do |tournament| %>
              <li>
                <%= link_to tournament.name, tournament_path(tournament), class: "text-emerald-700 hover:underline font-medium" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-slate-500">参加中のトーナメントはありません。</p>
        <% end %>

        <% if current_user.admin? %>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <%= link_to "トーナメントを作成", new_tournament_path, class: "inline-block px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium" %>
          </div>
        <% end %>
      </section>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm max-w-lg mx-auto">
      <p class="text-slate-600 mb-6 text-center">ログインしてトーナメントに参加しましょう。</p>
      <div class="space-y-3">
        <%= link_to "ログイン", new_session_path, class: "block text-center px-5 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium" %>
        <%= link_to "新規登録", new_registration_path, class: "block text-center px-5 py-2.5 border border-slate-300 rounded-lg hover:bg-slate-50 font-medium" %>
        <%= link_to "1 POINT SLAMとは？", about_path, class: "block text-center text-sm text-slate-500 hover:text-slate-700 underline" %>
      </div>
    </div>
  <% end %>
</div>
