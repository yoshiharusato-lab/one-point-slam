<h1 class="text-3xl font-bold text-slate-800 mb-6">メンバーリスト</h1>

<section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
  <% if @users.any? %>
    <ul class="grid sm:grid-cols-2 gap-2">
      <% @users.each do |user| %>
        <li>
          <%= link_to user_path(user), class: "flex items-center gap-3 px-3 py-2 bg-slate-50 rounded-lg hover:bg-emerald-50 transition" do %>
            <%= user_avatar_tag(user, css_class: "avatar avatar--sm") %>
            <span class="font-medium text-slate-800"><%= user.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-500">ユーザーがいません。</p>
  <% end %>
</section>
