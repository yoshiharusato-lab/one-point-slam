<% unless @user == current_user %>
  <div class="mb-6">
    <%= link_to "← ユーザー一覧へ", users_path, class: "text-slate-500 hover:text-slate-700 text-sm" %>
  </div>
<% end %>

<%= content_tag :div, class: "flex items-center gap-4 mb-8", data: (@user == current_user ? { controller: "avatar-preview" } : {}) do %>
  <%= user_avatar_tag(@user, css_class: "avatar avatar--lg", html_options: (@user == current_user ? { data: { avatar_preview_target: "image" } } : {})) %>
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold text-slate-800"><%= @user.name %></h1>
      <% if @user.admin? %>
        <span class="px-2 py-0.5 bg-amber-100 text-amber-800 rounded-full text-xs">管理者</span>
      <% end %>
    </div>

    <% if @user == current_user %>
      <%= form_with model: @user, method: :patch, class: "mt-2" do |form| %>
        <%= form.label :avatar, "プロフィール写真を選択", class: "inline-block px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg font-medium text-xs cursor-pointer hover:bg-emerald-100" %>
        <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/gif,image/webp", data: { avatar_preview_target: "input", action: "change->avatar-preview#preview" }, class: "sr-only" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm mb-6">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">参加確認</h2>

  <% if @user == current_user %>
    <%= form_with model: @user, method: :patch, class: "space-y-5" do |form| %>
      <div>
        <p class="text-sm font-medium text-slate-700 mb-2">2日目参加しますか？</p>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 text-sm text-slate-600">
            <%= form.radio_button :day2_attending, true, checked: @user.day2_attending == true, class: "text-emerald-600 focus:ring-emerald-500" %>
            する
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-600">
            <%= form.radio_button :day2_attending, false, checked: @user.day2_attending == false, class: "text-emerald-600 focus:ring-emerald-500" %>
            しない
          </label>
        </div>
      </div>

      <div>
        <p class="text-sm font-medium text-slate-700 mb-2">3日目参加しますか？</p>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 text-sm text-slate-600">
            <%= form.radio_button :day3_attending, true, checked: @user.day3_attending == true, class: "text-emerald-600 focus:ring-emerald-500" %>
            する
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-600">
            <%= form.radio_button :day3_attending, false, checked: @user.day3_attending == false, class: "text-emerald-600 focus:ring-emerald-500" %>
            しない
          </label>
        </div>
      </div>

      <%= form.submit "回答を保存", class: "px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium text-sm cursor-pointer" %>
    <% end %>
  <% else %>
    <dl class="space-y-2 text-sm">
      <div class="flex items-center gap-2">
        <dt class="text-slate-500 w-32">2日目参加:</dt>
        <dd><span class="px-2 py-0.5 rounded-full text-xs <%= attendance_badge_class(@user.day2_attending) %>"><%= @user.day2_attending_label %></span></dd>
      </div>
      <div class="flex items-center gap-2">
        <dt class="text-slate-500 w-32">3日目参加:</dt>
        <dd><span class="px-2 py-0.5 rounded-full text-xs <%= attendance_badge_class(@user.day3_attending) %>"><%= @user.day3_attending_label %></span></dd>
      </div>
    </dl>
  <% end %>
</section>

<section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">これまでの戦績</h2>

  <% if @participations.any? %>
    <ul class="space-y-3">
      <% @participations.each do |participant| %>
        <% tournament = participant.tournament %>
        <li class="p-3 rounded-lg border border-slate-100">
          <div class="flex items-center justify-between">
            <%= link_to tournament.name, tournament_path(tournament), class: "font-medium text-emerald-700 hover:underline" %>
            <span class="text-xs px-2 py-0.5 rounded-full <%= tournament_status_class(tournament) %>">
              <%= tournament_status_label(tournament) %>
            </span>
          </div>
          <p class="text-sm text-slate-500 mt-1">
            <%= PersonalRoundLabel.progress_label(participant) %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-500">まだトーナメントに参加していません。</p>
  <% end %>
</section>
