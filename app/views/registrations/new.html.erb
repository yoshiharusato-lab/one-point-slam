<div class="max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-slate-800 mb-6">新規登録</h1>

  <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
    <% if @user.errors.any? %>
      <div class="p-4 bg-red-50 text-red-600 rounded-lg border border-red-100">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "名前（例：22 佐藤吉遥）", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :email_address, "メールアドレス（例：26WM9999@student.gs.chiba-u.jp）", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :password, "パスワード", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "パスワード（確認）", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <%= form.submit "アカウントを作成", class: "w-full py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium cursor-pointer" %>

    <p class="text-center text-sm text-slate-500">
      すでにアカウントをお持ちですか？
      <%= link_to "ログイン", new_session_path, class: "text-emerald-700 underline" %>
    </p>
  <% end %>
</div>
