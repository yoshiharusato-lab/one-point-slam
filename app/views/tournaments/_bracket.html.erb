<%
  layout = bracket_left_right_center(tournament)
  champion = tournament.champion

  # トーナメント全体表示からは勝者を報告できないようにする(報告は Next Match
  # ページ(_my_match.html.erb)からのみ行える)。ここでは常にプロフィールへの
  # リンクとして表示する。
  render_player = lambda do |participant, match|
    state_class = bracket_player_state_class(participant, match)
    player_content = lambda do
      safe_join([
        user_avatar_tag(participant.user, css_class: "player-avatar"),
        content_tag(:span, participant.display_name, class: "player-name")
      ])
    end

    if participant
      link_to user_path(participant.user),
        class: [ "player", state_class ].reject(&:blank?).join(" "),
        &player_content
    else
      content_tag :span, "", class: "player is-empty"
    end
  end
%>

<div class="tournament-bracket-panel">
  <div class="tournament-table-header">
    <h1><%= tournament.name %></h1>
  </div>

  <% if champion %>
    <div class="tournament-champion-banner">
      <span class="champion-trophy">🏆</span>
      <span class="champion-label">優勝</span>
      <%= link_to user_path(champion.user), class: "champion-link" do %>
        <%= user_avatar_tag(champion.user, css_class: "champion-avatar") %>
        <span class="champion-player-name"><%= champion.display_name %></span>
      <% end %>
    </div>
  <% end %>

  <div class="tournament-bracket-wrap" data-controller="bracket">
    <svg class="bracket-lines" data-bracket-target="lines"></svg>

    <div class="tournament-bracket" data-bracket-target="bracket">
      <div class="bracket-side bracket-side-left">
        <% layout[:left].each_with_index do |round_data, i| %>
          <div class="round" data-side="left" data-round="<%= i %>">
            <div class="round-label"><%= round_data[:label] %></div>
            <div class="matches">
              <% round_data[:matches].each do |match| %>
                <div class="match <%= i.zero? ? 'round-one-match' : 'round-match' %> <%= bracket_match_state_class(match) %>">
                  <div class="player-wrap"><%= render_player.call(match.player1, match) %></div>
                  <div class="player-wrap"><%= render_player.call(match.player2, match) %></div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="bracket-center">
        <div class="round" data-side="center" data-round="0">
          <div class="round-label"><%= layout[:final][:label] %></div>
          <div class="matches">
            <% layout[:final][:matches].each do |match| %>
              <div class="match final-match <%= bracket_match_state_class(match) %>">
                <div class="player-wrap"><%= render_player.call(match.player1, match) %></div>
                <div class="player-wrap"><%= render_player.call(match.player2, match) %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="bracket-side bracket-side-right">
        <% layout[:right].reverse.each_with_index do |round_data, i| %>
          <% original_index = layout[:right].length - 1 - i %>
          <div class="round" data-side="right" data-round="<%= original_index %>">
            <div class="round-label"><%= round_data[:label] %></div>
            <div class="matches">
              <% round_data[:matches].each do |match| %>
                <div class="match <%= original_index.zero? ? 'round-one-match' : 'round-match' %> <%= bracket_match_state_class(match) %>">
                  <div class="player-wrap"><%= render_player.call(match.player1, match) %></div>
                  <div class="player-wrap"><%= render_player.call(match.player2, match) %></div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<p class="tree-bracket__hint">
  自分の試合では <span class="tree-bracket__hint-accent">名前をクリック</span> して勝者を報告できます（両者の報告が一致すると確定します）。
</p>
