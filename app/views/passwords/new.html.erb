<div class="max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-slate-800 mb-2">パスワードをお忘れですか？</h1>
  <p class="text-slate-500 text-sm mb-6">登録済みのメールアドレスに、再設定用のリンクを送ります。</p>

  <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "メールアドレス", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <%= form.submit "再設定メールを送る", class: "w-full py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium cursor-pointer" %>

    <p class="text-center text-sm text-slate-500">
      <%= link_to "ログインに戻る", new_session_path, class: "text-emerald-700 underline" %>
    </p>
  <% end %>
</div>
