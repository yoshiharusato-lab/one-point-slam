<div class="max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-slate-800 mb-6">新しいパスワードを設定</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :password, "新しいパスワード", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-emerald-500 focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <%= form.submit "保存する", class: "w-full py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 font-medium cursor-pointer" %>
  <% end %>
</div>
